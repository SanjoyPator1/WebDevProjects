// OAuth 2.0 Authorization Server Database Schema
// Design: UUIDs for business entities, integers for logs
// Token Strategy: JWT access tokens + database refresh tokens

Table users {
  id varchar [primary key, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  // Authentication - Required
  email varchar(255) [unique, not null]
  username varchar(50) [unique, not null] 
  hashed_password varchar(255) [not null]
  full_name varchar(255) [not null]
  
  // OpenID Connect Profile - Optional
  given_name varchar(100) [null]
  family_name varchar(100) [null]
  picture_url varchar(500) [null]
  
  // Contact & Verification
  email_verified boolean [not null, default: false]
  phone_number varchar(20) [null]
  phone_verified boolean [not null, default: false]
  
  // Preferences
  locale varchar(10) [not null, default: 'en']
  timezone varchar(50) [null]
  
  // Status & Activity
  last_login_at timestamp [null]
  is_active boolean [not null, default: true]
  is_superuser boolean [not null, default: false]
}

Table organizations {
  id varchar [primary key, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  // Identity - Required
  name varchar(255) [not null]
  slug varchar(100) [unique, not null, note: 'URL-friendly identifier (e.g., "acme-corp")']
  
  // Optional Identity
  domain varchar(255) [null, note: 'Email domain for auto-join (e.g., "acme.com")']
  description text [null]
  
  // Configuration
  settings json [null, note: 'Flexible organization settings']
  
  // Status
  is_active boolean [not null, default: true]
}

Enum role_enum {
  ADMIN
  MEMBER  
  GUEST
}

// Many-to-many: Users ↔ Organizations
Table user_organizations {
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  // Composite Primary Key
  user_id varchar [ref: > users.id, not null]
  org_id varchar [ref: > organizations.id, not null]
  
  // Access Control
  role role_enum [not null, default: 'MEMBER']
  permissions json [null, note: 'Optional granular permissions ["manage:channels"]']
  
  // Membership Lifecycle
  invited_at timestamp [not null, default: `now()`]
  joined_at timestamp [null, note: 'NULL = invitation pending']
  invited_by varchar [ref: > users.id, null, note: 'Who sent invitation']
  
  // Status
  is_active boolean [not null, default: true]
  
  Indexes {
    (user_id, org_id) [pk]
  }
}

Enum client_type_enum {
  CONFIDENTIAL
  PUBLIC
}

// OAuth Client Applications  
Table oauth_clients {
  client_id varchar [primary key, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  // Client Identity
  client_secret varchar(255) [null, note: 'NULL for public clients']
  client_name varchar(255) [not null]
  client_type client_type_enum [not null]
  
  // OAuth Configuration - All Required
  grant_types json [not null, note: 'Allowed flows ["authorization_code", "refresh_token"]']
  response_types json [not null, note: 'Response formats ["code"]'] 
  redirect_uris json [not null, note: 'Whitelisted callback URLs']
  allowed_scopes json [not null, note: 'Maximum permissions']
  default_scopes json [null, note: 'Auto-granted scopes']
  token_endpoint_auth_method varchar(50) [not null, default: 'client_secret_post']
  
  // Metadata
  description text [null]
  
  // Ownership
  organization_id varchar [ref: > organizations.id, not null]
  created_by varchar [ref: > users.id, not null]
  
  // Status
  is_active boolean [not null, default: true]
}

// Temporary Authorization Codes (5-10 min lifetime)
Table authorization_codes {
  code varchar [primary key, not null]
  created_at timestamp [not null, default: `now()`]
  
  // Request Context - All Required
  client_id varchar [ref: > oauth_clients.client_id, not null]
  user_id varchar [ref: > users.id, not null]
  organization_id varchar [ref: > organizations.id, not null]
  redirect_uri varchar(2048) [not null]
  scope varchar(1000) [not null]
  
  // PKCE - Optional (required for public clients)
  code_challenge varchar(255) [null, note: 'SHA256 hash for PKCE']
  code_challenge_method varchar(10) [null, note: 'S256 or plain']
  
  // Security Tokens - Optional
  state varchar(255) [null, note: 'CSRF protection']
  nonce varchar(255) [null, note: 'OpenID Connect replay protection']
  
  // Lifecycle
  expires_at timestamp [not null, note: '5-10 minutes from creation']
  used_at timestamp [null, note: 'When exchanged for tokens']
}

// Optional: JWT Blacklist for Critical Security
Table revoked_access_tokens {
  jti varchar [primary key, not null, note: 'JWT Token ID from payload']
  created_at timestamp [not null, default: `now()`]
  
  // Revocation Details
  reason varchar(255) [null, note: 'Why revoked: security, logout, admin']
  revoked_at timestamp [not null]
  revoked_by varchar [ref: > users.id, null, note: 'Admin who revoked']
  
  // Cleanup
  expires_at timestamp [not null, note: 'Original JWT expiration for cleanup']
}

// Long-lived Refresh Tokens (Database Storage)
Table refresh_tokens {
  token_id varchar [primary key, not null, note: 'UUID identifier']
  created_at timestamp [not null, default: `now()`]
  
  // Token Data
  token_hash varchar(255) [not null, note: 'Bcrypt hashed random string']
  
  // Ownership
  client_id varchar [ref: > oauth_clients.client_id, not null]
  user_id varchar [ref: > users.id, not null]
  organization_id varchar [ref: > organizations.id, not null]
  
  // Permissions
  scope varchar(1000) [not null, note: 'Inherited from auth code']
  
  // Security Tracking
  rotation_count integer [not null, default: 0, note: 'Refresh counter']
  last_used_at timestamp [null]
  
  // Lifecycle - SIMPLIFIED (removed is_active duplication)
  expires_at timestamp [not null, note: '30+ days from creation']
  revoked_at timestamp [null, note: 'NULL = active, timestamp = revoked']
}

Enum scope_category_enum {
  OPENID    [note: 'OpenID Connect standard']
  PROFILE   [note: 'User profile information']
  CHAT      [note: 'Chat application features'] 
  ADMIN     [note: 'Administrative functions']
}

// Permission Scopes Definition
Table scopes {
  scope_name varchar(100) [primary key, not null, note: 'Technical ID: read:messages']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  // Display Information
  display_name varchar(255) [not null, note: 'Human readable name']
  description text [null, note: 'Detailed explanation for consent']
  
  // Classification
  category scope_category_enum [not null]
  
  // Behavior
  is_default boolean [not null, default: false]
  requires_consent boolean [not null, default: true]
  organization_specific boolean [not null, default: false]
}

Enum audit_event_type_enum {
  USER_LOGIN
  USER_LOGOUT
  USER_REGISTRATION
  TOKEN_ISSUED
  TOKEN_REFRESHED  
  TOKEN_REVOKED
  CLIENT_REGISTERED
  AUTHORIZATION_GRANTED
  PASSWORD_RESET
  EMAIL_VERIFIED
  SECURITY_BREACH
}

Enum audit_status_enum {
  SUCCESS
  FAILURE
  WARNING
}

// Audit Trail for Security & Compliance
Table audit_logs {
  id integer [primary key, increment, note: 'Simple auto-increment for logs']
  created_at timestamp [not null, default: `now()`]
  
  // Event Classification
  event_type audit_event_type_enum [not null]
  status audit_status_enum [not null]
  
  // Context - All Optional for Flexibility
  user_id varchar [ref: > users.id, null]
  client_id varchar [ref: > oauth_clients.client_id, null]  
  organization_id varchar [ref: > organizations.id, null]
  
  // Request Information
  ip_address varchar(45) [null, note: 'IPv4 or IPv6']
  user_agent varchar(500) [null]
  
  // Additional Data
  event_data json [null, note: 'Flexible event details']
  error_message text [null, note: 'Error details for failed events']
}

// Performance Indexes
Indexes {
  // User Performance
  users.email [unique]
  users.username [unique]
  users.is_active
  users.last_login_at
  
  // Organization Performance
  organizations.slug [unique]
  organizations.domain
  organizations.is_active
  
  // OAuth Performance  
  authorization_codes.expires_at
  authorization_codes.client_id
  refresh_tokens.expires_at
  refresh_tokens.client_id
  revoked_access_tokens.expires_at
  
  // Audit Performance
  audit_logs.created_at
  audit_logs.user_id
  audit_logs.event_type
  
  // Composite Indexes
  (user_organizations.user_id, user_organizations.is_active)
  (refresh_tokens.client_id, refresh_tokens.user_id)
  (audit_logs.event_type, audit_logs.created_at)
}